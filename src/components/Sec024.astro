---
// src/components/sections/BudgetHomesSection.astro

import content from "../data/sec024.json";

const section = content.budgetHomes;
---

<section class="bg-[#f5f5f5] py-8 lg:py-10">
  <div class="mx-auto w-[90%] max-w-[1320px]">

    <!-- TOP -->
    <div
      class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"
    >

      <!-- LEFT -->
      <div>
        <h2
          class="text-4xl tracking-tight text-[#2d1b3d] lg:text-7xl"
        >
          {section.heading}
        </h2>

        <p
          class="mt-2 max-w-[780px] text-[16px] leading-[1.7] text-[#4b5563] lg:text-[16px]"
        >
          {section.description}
        </p>
      </div>

      <!-- BUTTON -->
      <div>
        <a
          href={section.button.link}
          class="inline-flex items-center justify-center rounded-full bg-[#ef5a5a] px-8 py-4 text-sm font-semibold uppercase tracking-[1px] text-white shadow-md transition duration-300 hover:-translate-y-1 hover:bg-[#dc3f3f] hover:shadow-xl"
        >
          {section.button.text}
        </a>
      </div>

    </div>

    <!-- CARDS -->
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">

      {
        section.homes.map((item) => (
          <div
            class="group overflow-hidden rounded-[16px] bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-2xl"
          >

            <!-- IMAGE -->
            <div class="relative overflow-hidden rounded-[16px]">

              <img
                src={item.image}
                alt={item.title}
                class="h-[500px] w-full object-cover transition duration-700 group-hover:scale-110"
              />

              <!-- OVERLAY -->
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent"
              ></div>

              <!-- PRICE TAG -->
              <div
                class="absolute left-4 top-4 rounded-full border border-white/40 bg-[#6d4b67]/95 px-5 py-2 text-[15px] font-semibold text-white shadow-lg backdrop-blur-sm"
              >
                {item.price}
              </div>

              <!-- TITLE -->
              <div class="absolute bottom-5 left-5">
                <h3
                  class="text-[34px] font-bold tracking-wide text-white"
                >
                  {item.title}
                </h3>
              </div>

            </div>

          </div>
        ))
      }

    </div>

    <!-- FOOTER -->
    <p
      class="mt-5 text-[15px] text-[#4b5563]"
    >
      {section.footerText}
    </p>

  </div>
</section>