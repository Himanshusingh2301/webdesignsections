---
// src/components/sections/BespokeInteriorServices.astro

import content from "../data/sec029.json";

const section = content.bespokeInteriorServices;
---

<section class="bg-[#f5f5f5] py-8 lg:py-10">
  <div class="mx-auto w-[90%] max-w-[1380px]">

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">

      <!-- LEFT ORANGE BOX -->
      <div
        class="flex min-h-[480px] items-center justify-center bg-[#f39a21] px-6 py-10 text-center"
      >
        <h2
          class="text-4xl font-light leading-[1.25] text-white lg:text-[50px]"
        >
          {section.heading}
        </h2>
      </div>

      <!-- SERVICE CARDS -->
      {
        section.services.map((item) => (
          <div
            class="flex min-h-[480px] flex-col items-center bg-[#f7f7f7] px-6 py-10 text-center transition duration-300 hover:-translate-y-1 hover:shadow-xl"
          >

            <!-- ICON -->
            <div class="mb-6">
              <img
                src={item.icon}
                alt={item.title}
                class="h-[90px] w-[90px] object-contain"
              />
            </div>

            <!-- TITLE -->
            <h3
              class="text-[20px] font-medium leading-[1.4] text-[#1f2937]"
            >
              {item.title}
            </h3>

            <!-- DESCRIPTION -->
            <p
              class="mt-5 text-[16px] leading-[1.8] text-[#374151]"
            >
              {item.description}
            </p>

            <!-- BUTTON -->
            <a
              href={item.link}
              class="mt-8 text-[16px] font-semibold text-[#374151] transition duration-300 hover:text-[#f39a21]"
            >
              {item.buttonText}
            </a>

          </div>
        ))
      }

    </div>

  </div>
</section>