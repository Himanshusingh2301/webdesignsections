---


import content from "../data/usecases.json";
---

<section
  class="w-full overflow-hidden bg-[#f5f5f5] py-20 lg:py-28"
  aria-labelledby="use-cases-heading"
>
  <div
    class="mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2"
  >
    <!-- LEFT CONTENT -->
    <div class="max-w-[580px]">
      <span
        class="text-sm font-semibold uppercase tracking-[1px] text-[#00A3FF]"
      >
        {content.sectionLabel}
      </span>

      <h2
        id="use-cases-heading"
        class="mt-4 text-4xl  leading-tight tracking-[-1px] text-[#111827] lg:text-4xl"
      >
        {content.slides[0].title}
      </h2>

      <p
        class="mt-6 text-lg leading-[1.9] text-[#4B5563] lg:text-[22px]"
      >
        {content.slides[0].description}
      </p>

      <a
        href={content.slides[0].button.link}
        class="mt-12 inline-block text-[18px] font-medium text-[#3b3b3b] underline underline-offset-4"
      >
        {content.slides[0].button.label}
      </a>

      <!-- SLIDER BUTTONS -->
      <div class="mt-24 flex items-center gap-5">
        <button
          id="prevBtn"
          aria-label="Previous Slide"
          class="flex h-[58px] w-[125px] items-center justify-center rounded-full border border-[#d9d9ef] bg-transparent transition hover:bg-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.7"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>

        <button
          id="nextBtn"
          aria-label="Next Slide"
          class="flex h-[58px] w-[125px] items-center justify-center rounded-full border border-[#d9d9ef] bg-transparent transition hover:bg-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.7"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
      </div>
    </div>

    <!-- RIGHT IMAGE STACK -->
    <div class="relative flex justify-center lg:justify-end">
      <!-- BACK IMAGE -->
      <img
        id="backImage"
        src={content.slides[1].image}
        alt=""
        class="absolute right-[70px] top-[35px] h-[360px] w-[380px] rounded-[28px] object-cover opacity-60"
      />

      <!-- MIDDLE IMAGE -->
      <img
        id="middleImage"
        src={content.slides[2].image}
        alt=""
        class="absolute right-[35px] top-[18px] h-[360px] w-[400px] rounded-[28px] object-cover opacity-80"
      />

      <!-- MAIN IMAGE -->
      <img
        id="mainImage"
        src={content.slides[0].image}
        alt={content.slides[0].title}
        class="relative z-10 h-[360px] w-full max-w-[620px] rounded-[32px] object-cover shadow-[0_25px_80px_rgba(0,0,0,0.12)] transition-all duration-500"
      />
    </div>
  </div>
</section>

<!-- SLIDER SCRIPT -->
<script define:vars={{ slides: content.slides }}>
  let current = 0;

  const title = document.querySelector("#use-cases-heading");
  const desc = document.querySelector("p");
  const btn = document.querySelector("a");

  const mainImage = document.querySelector("#mainImage");
  const middleImage = document.querySelector("#middleImage");
  const backImage = document.querySelector("#backImage");

  const nextBtn = document.querySelector("#nextBtn");
  const prevBtn = document.querySelector("#prevBtn");

  function updateSlider() {
    const total = slides.length;

    const currentSlide = slides[current];
    const middleSlide = slides[(current + 1) % total];
    const backSlide = slides[(current + 2) % total];

    title.textContent = currentSlide.title;
    desc.textContent = currentSlide.description;
    btn.textContent = currentSlide.button.label;
    btn.href = currentSlide.button.link;

    mainImage.src = currentSlide.image;
    mainImage.alt = currentSlide.title;

    middleImage.src = middleSlide.image;
    backImage.src = backSlide.image;
  }

  nextBtn.addEventListener("click", () => {
    current = (current + 1) % slides.length;
    updateSlider();
  });

  prevBtn.addEventListener("click", () => {
    current = (current - 1 + slides.length) % slides.length;
    updateSlider();
  });

  // AUTO SLIDE
  setInterval(() => {
    current = (current + 1) % slides.length;
    updateSlider();
  }, 5000);
</script>