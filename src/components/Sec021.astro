---
// src/components/sections/InteriorServicesSection.astro

import content from "../data/sec021.json";

const section = content.interiorServices;
---

<section class="bg-[#f5f5f5] py-10 lg:py-14">
  <div class="mx-auto w-[92%] max-w-[1600px]">

    <!-- HEADING -->
    <div class="mb-10 text-center">
      <h2
        class="text-3xl font-bold tracking-tight text-[#111827] lg:text-5xl"
      >
        {section.heading}
      </h2>

      <p
        class="mt-3 text-xl font-medium text-[#111827] lg:text-[30px]"
      >
        {section.subheading}
      </p>

      <div
        class="mx-auto mt-4 h-[2px] w-[180px] bg-[#1f2937]"
      ></div>
    </div>

    <!-- SERVICES -->
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        section.services.map((item) => (
          <div class="group">

            <!-- IMAGE -->
            <div class="overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="h-[380px] w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <!-- CONTENT -->
            <div class="pt-4">

              <!-- TITLE + ICON -->
              <div class="flex items-start justify-between gap-3">
                <h3
                  class="text-[22px] font-semibold leading-snug text-[#111827]"
                >
                  {item.title}
                </h3>

                <a
                  href={item.link}
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#111827] text-lg text-white transition duration-300 hover:bg-[#f59e0b]"
                >
                  →
                </a>
              </div>

              <!-- DESCRIPTION -->
              <p
                class="mt-3 text-[15px] leading-[1.7] text-[#374151]"
              >
                {item.description}
              </p>

            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>