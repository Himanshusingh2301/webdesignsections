---
// src/components/sections/SpecializedDepartments.astro

import content from "../data/sec009.json";

const section = content.specializedDepartments;
---

<section class="relative overflow-hidden pt-20 pb-36">
  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src={section.backgroundImage}
      alt="Background"
      class="h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-[#0b6970]/80"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4">
    <!-- Heading -->
    <div class="mx-auto max-w-4xl text-center text-white">
      <h2 class="text-4xl  md:text-4xl">
        {section.heading}
      </h2>

      <p class="mx-auto mt-6 max-w-4xl text-lg leading-9 text-white/90">
        {section.description}
      </p>
    </div>

    <!-- Cards -->
    <div class="mt-20 grid gap-8 lg:grid-cols-3">
      {section.departments.map((item) => (
        <div
          class="group relative overflow-visible rounded-[20px] bg-[#f7f7f7] px-10 pt-16 pb-44 text-center shadow-[0_10px_35px_rgba(0,0,0,0.08)] transition duration-300 hover:-translate-y-2"
        >
          <!-- Title -->
          <h3 class="text-[36px]  text-black">
            {item.title}
          </h3>

          <!-- Description -->
          <p class="mx-auto mt-8 max-w-[340px] text-[18px] leading-[2] text-[#7b7b7b]">
            {item.description}
          </p>

          <!-- Bottom Big Circle -->
          <div
            class="absolute left-1/2 bottom-[-78px] flex h-[190px] w-[190px] -translate-x-1/2 flex-col items-center rounded-full bg-[#4f7562]"
          >
            <!-- Arrow -->
            <button
              class="absolute top-[-28px] flex h-[68px] w-[68px] items-center justify-center rounded-full border-[6px] border-[#f7f7f7] bg-[#005864] text-white transition duration-300 hover:scale-110 hover:bg-[#084f57]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 12h14"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 6l6 6-6 6"
                />
              </svg>
            </button>

            <!-- Icon -->
            <div class="mt-16 flex items-center justify-center">
              <img
                src={item.icon}
                alt={item.title}
                class="h-16 w-16 object-contain"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>