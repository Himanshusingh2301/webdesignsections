---

import content from "../data/hero.json";

const section = content.riskMitigation;
---

<section
  class="w-full bg-[#f5f5f5] py-16 lg:py-24"
  aria-labelledby="risk-mitigation-heading"
>
  <div
    class="mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-2 lg:gap-20"
  >
    <!-- Image -->
    <div class="order-2 lg:order-1">
      <div
        class="overflow-hidden rounded-[32px] shadow-[0_20px_60px_rgba(0,0,0,0.08)]"
      >
        <img
          src={section.image}
          alt="Smart water leak detection and risk mitigation system"
          loading="lazy"
          width="520"
          height="450"
          class="h-[350px] w-full object-cover sm:h-[420px] lg:h-[520px]"
        />
      </div>
    </div>

    <!-- Content -->
    <div class="order-1 lg:order-2">
      <!-- SEO Heading -->
      <h1
        id="risk-mitigation-heading"
        class="max-w-3xl text-4xl leading-tight tracking-[-1px] text-[#111111] sm:text-4xl lg:text-4xl"
      >
        {section.title}
      </h1>

      <!-- SEO Friendly Content -->
      <div
        class="mt-8 space-y-7 text-lg leading-[1.9] text-[#4b5563] lg:text-[16px]"
      >
        {section.paragraphs.map((item) => (
          <p set:html={item}></p>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="mt-12 flex flex-wrap items-center gap-5">
        <a
          href={section.primaryButton.link}
          class="inline-flex items-center justify-center rounded-full bg-[#F59E0B] px-8 py-4 text-base font-semibold text-white shadow-md transition duration-300 hover:-translate-y-1 hover:bg-[#e69208]"
        >
          {section.primaryButton.label}
        </a>

        <a
          href={section.secondaryButton.link}
          class="inline-flex items-center justify-center rounded-full bg-[#0EA5E9] px-8 py-4 text-base font-semibold text-white shadow-md transition duration-300 hover:-translate-y-1 hover:bg-[#0284c7]"
        >
          {section.secondaryButton.label}
        </a>
      </div>
    </div>
  </div>
</section>