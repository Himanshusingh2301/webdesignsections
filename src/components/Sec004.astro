---
// src/components/sections/AboutStatsSection.astro

import content from "../data/sec004.json";

const section = content.aboutSection;
---

<section
  class="w-full bg-[#f5f5f5] py-20 lg:py-28"
  aria-labelledby="about-section-heading"
>
  <div class="mx-auto max-w-[1360px] px-6">
    
    <!-- TOP HEADING -->
    <div class="mx-auto max-w-4xl text-center">
      <h2
        id="about-section-heading"
        class="text-4xl  leading-tight tracking-[-1px] text-black lg:text-4xl"
      >
        {section.heading.before}
        <span class="text-[#d71920]">
          {section.heading.highlight}
        </span>
      </h2>

      <p
        class="mx-auto mt-6 max-w-3xl text-[22px] leading-[1.7] text-[#666]"
      >
        {section.subheading}
      </p>
    </div>

    <!-- MAIN GRID -->
    <div
      class="mt-20 grid items-start gap-12 lg:grid-cols-[1.15fr_.85fr]"
    >
      <!-- LEFT CONTENT -->
      <div>
        <!-- Title -->
        <h3
          class="text-xl  leading-tight text-black lg:text-4xl"
        >
          {section.content.title}
        </h3>

        <!-- Paragraphs -->
        <div
          class="mt-7 space-y-4 text-[16px] leading-[1.9] text-[#5d6773]"
        >
          {section.content.paragraphs.map((item) => (
            <p>{item}</p>
          ))}
        </div>

        <!-- INFO BOXES -->
        <div class="mt-10 space-y-6">
          
          <!-- Mission -->
          <div class="rounded-2xl bg-[#ececec] p-8">
            <h4 class="text-2xl font-semibold text-black">
              {section.mission.title}
            </h4>

            <p
              class="mt-4 text-[16px] leading-[1.8] text-[#667085]"
            >
              {section.mission.description}
            </p>
          </div>

          <!-- Values -->
          <div class="rounded-2xl bg-[#ececec] p-8">
            <h4 class="text-2xl font-semibold text-black">
              {section.values.title}
            </h4>

            <ul
              class="mt-5 space-y-4 text-[16px] leading-[1.8] text-[#667085]"
            >
              {section.values.items.map((item) => (
                <li>
                  • <strong>{item.label}</strong>: {item.text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- RIGHT STATS -->
      <div class="grid gap-8 sm:grid-cols-2">
        {section.stats.map((item) => (
          <div
            class="flex min-h-[260px] flex-col items-center justify-center rounded-2xl bg-[#fdfdfd] p-10 text-center shadow-sm"
          >
            <!-- Icon Circle -->
            <div
              class="flex h-24 w-24 items-center justify-center rounded-full bg-[#ed1c24]"
            >
              <img
                src={item.icon}
                alt={item.title}
                class="h-10 w-10 object-contain"
              />
            </div>

            <!-- Number -->
            <h4
              class="mt-8 text-5xl font-bold leading-none text-black"
            >
              {item.number}
            </h4>

            <!-- Label -->
            <p
              class="mt-4 text-[16px] leading-[1.6] text-[#667085]"
            >
              {item.title}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>