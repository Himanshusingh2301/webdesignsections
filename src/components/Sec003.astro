---
// src/components/sections/TextImageSection.astro

import content from "../data/sec003.json";

const section = content.outdoorLighting;
---

<section
  class="w-full bg-[#f5f5f5] py-16 lg:py-24"
  aria-labelledby="text-image-heading"
>
  <div
    class="mx-auto grid max-w-[1300px] items-center gap-12 px-6 lg:grid-cols-[1.1fr_.9fr]"
  >
    <!-- LEFT CONTENT -->
    <div class="max-w-[760px]">
      <div
        class="space-y-5 text-[16px] leading-[1.9] text-black"
      >
        {section.paragraphs.map((item) => (
          <p>{item}</p>
        ))}
      </div>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="relative">
      <div class="overflow-hidden rounded-sm">
        <img
          src={section.image}
          alt={section.imageAlt}
          width="900"
          height="700"
          loading="lazy"
          class="h-[320px] w-full object-cover transition duration-500 hover:scale-105 lg:h-[320px]"
        />
      </div>
    </div>
  </div>
</section>