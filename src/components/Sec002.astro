---
// src/components/sections/PricingTableSection.astro

import content from "../data/sec002.json";

const section = content.pricingTable;
---

<section
  class="flex min-h-[50vh] w-full items-center bg-[#f5f5f5] py-20 lg:py-28"
  aria-labelledby="pricing-table-heading"
>
  <div class="mx-auto w-full max-w-5xl px-6 text-center">
    
    <!-- Heading -->
    <h2
      id="pricing-table-heading"
      class="text-4xl leading-[1.15] tracking-[-1px] text-[#1f1f1f] lg:text-4xl"
    >
      {section.title}
    </h2>

    <!-- Subtitle -->
    <p
      class="mx-auto mt-5 max-w-4xl text-[16px] leading-[1.8] text-[#2f2f2f]"
    >
      {section.description}
    </p>

    <!-- Table -->
    <div class="mt-10 overflow-x-auto">
      <table
        class="mx-auto w-full max-w-3xl border border-[#6f6f6f] text-left"
      >
        <thead>
          <tr>
            {section.columns.map((column) => (
              <th
                class="border border-[#6f6f6f] px-5 py-4 text-[20px] font-semibold text-[#1f1f1f]"
              >
                {column}
              </th>
            ))}
          </tr>
        </thead>

        <tbody>
          {section.rows.map((row) => (
            <tr>
              <td
                class="border border-[#6f6f6f] px-5 py-4 text-[16px] leading-[1.6] text-[#2f2f2f]"
              >
                {row.service}
              </td>

              <td
                class="border border-[#6f6f6f] px-5 py-4 text-[18px] leading-[1.6] text-[#2f2f2f]"
              >
                {row.price}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Bottom Note -->
    <p
      class="mx-auto mt-10 max-w-4xl text-[14px] italic leading-[1.8] text-[#3f3f3f]"
    >
      {section.note}
    </p>
  </div>
</section>