---
// src/components/sections/MedicalHeroSection.astro

import content from "../data/sec007.json";

const section = content.medicalHero;
---

<section
  class="relative overflow-hidden bg-[#f5f5f5]"
  aria-labelledby="medical-hero-heading"
>
  <!-- TOP BAR -->
  <div class="relative z-30 h-[38px] overflow-hidden bg-transparent lg:h-[60px]">
  
  <!-- RIGHT GREEN BAR -->
  <div
    class="absolute right-0 top-0 h-full w-[82%] bg-[#01535a]"
    style="clip-path: polygon(8% 0, 100% 0, 100% 100%, 0% 100%)"
  ></div>
  
    
    <!-- INCLINED SHAPE -->
    <div
      class="absolute left-0 top-0 hidden h-full w-[220px] bg-[#01535a] lg:block"
      style="clip-path: polygon(0 0, 85% 0, 100% 100%, 0% 100%)"
    ></div>

    <!-- TOP CONTENT -->
    <div
      class="relative mx-auto flex max-w-[1800px] justify-end px-6 py-4 sm:px-10 lg:px-20"
    >
      <p class="text-right text-sm font-medium text-white lg:text-[16px]">
        {section.topBar.text}

        <a
          href={section.topBar.link}
          class="ml-2 underline underline-offset-4"
        >
          {section.topBar.linkLabel}
        </a>
      </p>
    </div>
  </div>

  <!-- HERO -->
  <div class="relative min-h-[92vh] w-full">
    
    <!-- BACKGROUND SLIDER -->
    <div class="absolute inset-0">
      {section.images.map((image, index) => (
        <img
          src={image}
          alt={`Medical Hero ${index + 1}`}
          width="1800"
          height="1200"
          loading="lazy"
          class={`hero-slide absolute inset-0 h-full w-full object-cover ${
            index === 0 ? "active" : ""
          }`}
        />
      ))}
    </div>

    <!-- OVERLAY -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-white via-white/90 to-transparent"
    ></div>

    <!-- DARK OVERLAY -->
    <div class="absolute inset-0 bg-black/10"></div>

    <!-- CONTENT -->
    <div
      class="relative z-20 mx-auto flex min-h-[92vh] max-w-[1800px] items-center px-6 sm:px-10 lg:px-20"
    >
      <div class="max-w-[650px]">
        
        <!-- SUBTITLE -->
        <p
          class="font-serif text-[18px] italic text-[#4e7a66] sm:text-[22px] lg:text-[36px]"
        >
          {section.subtitle}
        </p>

        <!-- HEADING -->
        <h1
          id="medical-hero-heading"
          class="mt-5 text-4xl leading-[1.05] tracking-[-1px] text-[#04545d] sm:text-6xl lg:text-6xl"
        >
          {section.headingFirst}

          <span class="block text-[#4e7a66]">
            {section.headingSecond}
          </span>
        </h1>

        <!-- DESCRIPTION -->
        <p
          class="mt-8 max-w-[560px] text-[16px] leading-[1.9] text-[#6b6b6b] sm:text-[18px] lg:text-[20px]"
        >
          {section.description}
        </p>

        <!-- BUTTONS -->
        <div class="mt-10 flex flex-wrap items-center gap-4">
          
          <!-- CALL BUTTON -->
          <a
            href={`tel:${section.callButton.number}`}
            class="inline-flex items-center justify-center rounded-full bg-[#01535a] px-8 py-4 text-[16px] font-medium text-white transition duration-300 hover:bg-[#013d42]"
          >
            📞 {section.callButton.label}
          </a>

          <!-- SECONDARY BUTTON -->
          <a
            href={section.secondaryButton.link}
            class="inline-flex items-center justify-center rounded-full border border-[#01535a] px-8 py-4 text-[16px] font-medium text-[#01535a] transition duration-300 hover:bg-[#01535a] hover:text-white"
          >
            {section.secondaryButton.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-slide.active {
    opacity: 1;
  }
</style>

<script>
  const slides = document.querySelectorAll(".hero-slide");

  let current = 0;

  setInterval(() => {
    slides[current].classList.remove("active");

    current = (current + 1) % slides.length;

    slides[current].classList.add("active");
  }, 4000);
</script>