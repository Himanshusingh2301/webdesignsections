---
// src/components/sections/CommercialInteriorSection.astro

import content from "../data/sec023.json";

const section = content.commercialInterior;
---

<section class="bg-[#f5f5f5] py-6 lg:py-10">
  <div class="mx-auto w-[90%] max-w-[1320px]">

    <!-- HEADING -->
    <div class="mb-7 text-center">
      <h2
        class="text-3xl font-bold tracking-tight text-[#111827] lg:text-4xl"
      >
        {section.heading}
      </h2>

      <div
        class="mx-auto mt-4 h-[2px] w-[150px] bg-[#1f2937]"
      ></div>
    </div>

    <!-- SERVICES -->
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        section.services.map((item) => (
          <div
            class="group rounded-[8px] bg-white p-2 transition duration-300 hover:-translate-y-1 hover:shadow-lg"
          >

            <!-- IMAGE -->
            <div class="overflow-hidden rounded-[6px]">
              <img
                src={item.image}
                alt={item.title}
                class="h-[360px] w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <!-- CONTENT -->
            <div class="pt-3">

              <!-- TITLE -->
              <h3
                class="text-[18px] font-semibold leading-snug text-[#111827]"
              >
                {item.title}
              </h3>

              <!-- DESCRIPTION -->
              <p
                class="mt-2 text-[14px] leading-[1.6] text-[#374151]"
              >
                {item.description}
              </p>

              <!-- EXPLORE BUTTON -->
              <div class="mt-4">
                <a
                  href={item.link}
                  class="inline-flex items-center gap-2 text-[16px] font-medium text-[#f59e0b] transition duration-300 hover:gap-3"
                >
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-[#f59e0b] text-lg text-white"
                  >
                    →
                  </span>

                  <span>Explore</span>
                </a>
              </div>

            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>