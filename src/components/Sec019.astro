---
// src/components/sections/InteriorPricingComparison.astro

import content from "../data/sec019.json";

const section = content.interiorPricingComparison;
---

<section class="bg-[#f5f5f5] py-12 lg:py-16">
  <div class="mx-auto w-[88%] max-w-[1180px]">

    <!-- HEADING -->
    <div class="text-center">
      <h2
        class="text-3xl font-light leading-[1.1] tracking-[-1px] text-[#111827] sm:text-5xl lg:text-[44px]"
      >
        <span class="font-semibold">
          {section.headingBold}
        </span>

        {section.headingLight}
      </h2>

      <p
        class="mx-auto mt-3 max-w-[850px] text-[15px] leading-[1.5] text-[#374151] lg:text-[20px]"
      >
        {section.subheading}
      </p>
    </div>

    <!-- TABLE -->
    <div class="mt-10 overflow-x-auto rounded-[6px]">

      <table
        class="w-full border-collapse border border-[#9ca3af] bg-transparent"
      >

        <!-- TABLE HEAD -->
        <thead>
          <tr>

            <th
              class="border border-[#9ca3af] px-4 py-3 text-left text-[16px] font-medium text-[#111827]"
            >
            </th>

            <th
              class="border border-[#9ca3af] px-4 py-3 text-center text-[16px] font-semibold text-[#111827] lg:text-[16px]"
            >
              {section.columnOne}
            </th>

            <th
              class="border border-[#9ca3af] px-4 py-3 text-center text-[16px] font-semibold text-[#111827] lg:text-[16px]"
            >
              {section.columnTwo}
            </th>

          </tr>
        </thead>

        <!-- TABLE BODY -->
        <tbody>

          {section.rows.map((row) => (
            <tr>

              <!-- LEFT TITLE -->
              <td
                class="w-[22%] border border-[#9ca3af] px-4 py-3 align-middle text-[14px] font-semibold uppercase leading-[1.3] text-[#1f2937] lg:text-[16px]"
              >
                {row.title}
              </td>

              <!-- GOOD -->
              <td
                class="w-[39%] border border-[#9ca3af] px-4 py-3 align-top"
              >
                <div class="space-y-1">
                  {row.good.map((item) => (
                    <p class="text-[14px] leading-[1.5] text-[#374151] lg:text-[15px]">
                      {item}
                    </p>
                  ))}
                </div>
              </td>

              <!-- BAD -->
              <td
                class="w-[39%] border border-[#9ca3af] px-4 py-3 align-top"
              >
                <div class="space-y-1">
                  {row.bad.map((item) => (
                    <p class="text-[16px] leading-[1.5] text-[#374151] lg:text-[16px]">
                      {item}
                    </p>
                  ))}
                </div>
              </td>

            </tr>
          ))}

        </tbody>
      </table>
    </div>
  </div>
</section>