---
// src/components/sections/ContactSection.astro

import content from "../data/sec031.json";

const section = content.contactSection;
---

<section class="bg-[#f5f5f5] py-8 lg:py-10">

  <div
    class="mx-auto grid w-[90%] max-w-[1180px] items-start gap-10 lg:grid-cols-2"
  >

    <!-- LEFT -->
    <div class="mx-auto w-full max-w-[540px]">

      <!-- HEADING -->
      <div class="text-center">

        <h2
          class="text-3xl font-bold tracking-tight text-[#111827] lg:text-5xl"
        >
          {section.heading}
        </h2>

        <div
          class="mx-auto mt-4 h-[2px] w-[120px] bg-[#4b5563]"
        ></div>

      </div>

      <!-- FORM -->
      <form class="mt-8 space-y-4">

        <!-- NAME -->
        <input
          type="text"
          placeholder="Name"
          class="h-[58px] w-full border border-[#b8c0d1] bg-transparent px-5 text-[17px] text-[#374151] outline-none transition duration-300 focus:border-[#2563eb]"
        />

        <!-- MOBILE -->
        <input
          type="text"
          placeholder="Mobile Number"
          class="h-[58px] w-full border border-[#b8c0d1] bg-transparent px-5 text-[17px] text-[#374151] outline-none transition duration-300 focus:border-[#2563eb]"
        />

        <!-- EMAIL -->
        <input
          type="email"
          placeholder="Email"
          class="h-[58px] w-full border border-[#b8c0d1] bg-transparent px-5 text-[17px] text-[#374151] outline-none transition duration-300 focus:border-[#2563eb]"
        />

        <!-- MESSAGE -->
        <textarea
          placeholder="Message"
          class="h-[140px] w-full resize-none border border-[#b8c0d1] bg-transparent px-5 py-4 text-[17px] text-[#374151] outline-none transition duration-300 focus:border-[#2563eb]"
        ></textarea>

        <!-- BUTTON -->
        <button
          type="submit"
          class="inline-flex items-center justify-center bg-[#2f6cb3] px-8 py-4 text-[18px] font-semibold text-white transition duration-300 hover:bg-[#1d4f8a]"
        >
          {section.buttonText}
        </button>

      </form>

    </div>

    <!-- RIGHT -->
    <div class="mx-auto mt-[105px] w-full max-w-[520px]">

      <!-- MAP -->
      <div class="overflow-hidden rounded-[4px] shadow-sm">

        <iframe
          src={section.mapUrl}
          width="100%"
          height="380"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>

      </div>

      <!-- SOCIAL -->
      <div class="mt-5 flex items-center justify-center gap-4">

        {
          section.socialLinks.map((item) => (
            <a
              href={item.link}
              class={`flex h-[48px] w-[48px] items-center justify-center rounded-full text-white transition duration-300 hover:scale-110 ${item.bg}`}
            >
              <span class="text-[22px]">
                {item.icon}
              </span>
            </a>
          ))
        }

      </div>

    </div>

  </div>

</section>