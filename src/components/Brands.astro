---
// src/components/sections/TrustedBrandsSection.astro

import content from "../data/brands.json";

const section = content.trustedBrands;
---

<section
  class="w-full bg-[#f5f5f5] py-14 lg:py-20"
  aria-labelledby="trusted-brands-heading"
>
  <div class="mx-auto max-w-7xl px-6">
    
    <!-- Hidden SEO Heading -->
    <h2 id="trusted-brands-heading" class="sr-only">
      Trusted by Leading Companies and Organizations
    </h2>

    <!-- Logos -->
    <div
      class="grid grid-cols-2 items-center gap-x-10 gap-y-12 md:grid-cols-3 lg:grid-cols-6"
    >
      {section.brands.map((brand) => (
        <a
          href={brand.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-center opacity-70 transition duration-300 hover:opacity-100"
          aria-label={brand.name}
        >
          <img
            src={brand.logo}
            alt={brand.name}
            loading="lazy"
            width="220"
            height="100"
            class="max-h-[70px] w-auto object-contain grayscale transition duration-300 group-hover:grayscale-0"
          />
        </a>
      ))}
    </div>
  </div>
</section>