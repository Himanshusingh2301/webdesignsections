---
// src/components/sections/HeroSection.astro

import content from "../data/waterlick.json";

const hero = content.hero;
---

<section
  class="relative min-h-screen overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src={hero.image}
      alt={hero.title}
      class="h-full w-full object-cover"
      loading="eager"
      width="1920"
      height="1080"
    />

    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black/55"></div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24"
  >
    <div class="max-w-4xl text-white">
   
     

      <!-- Heading -->
      <h1
        id="hero-heading"
        class="text-6xl  leading-[1.05] tracking-[-2px] lg:text-6xl"
      >
        {hero.title}
      </h1>

      <!-- Description -->
      <p
        class="mt-8 max-w-2xl text-sm leading-[1.8] text-white/90 lg:text-lg"
      >
        {hero.description}
      </p>

      <!-- Buttons -->
      <div class="mt-12 flex flex-wrap gap-5">
        <a
          href={hero.primaryButton.link}
          class="inline-flex items-center justify-center bg-[#ff6b1a] px-8 py-5 text-lg font-semibold uppercase tracking-wide text-white transition duration-300 hover:bg-[#e65d12]"
        >
          {hero.primaryButton.label}
        </a>

        <a
          href={hero.secondaryButton.link}
          class="inline-flex items-center justify-center bg-white px-8 py-5 text-lg font-semibold uppercase tracking-wide text-[#111827] transition duration-300 hover:bg-gray-200"
        >
          {hero.secondaryButton.label}
        </a>
      </div>
    </div>
  </div>
</section>