---
// src/components/sections/MedicalSplitSimple.astro

import content from "../data/sec006.json";

const section = content.medicalSimple;
---

<section
  class="w-full bg-[#f5f5f5]"
  aria-labelledby="medical-simple-heading"
>
  <div
    class="mx-auto grid min-h-[70vh] max-w-[1200px] items-center gap-12 px-6 py-16 sm:px-10 lg:grid-cols-2 lg:px-16"
  >
    
    <!-- LEFT CONTENT -->
    <div class="max-w-[560px]">
      
      <!-- Heading -->
      <h2
        id="medical-simple-heading"
        class="text-4xl leading-[1.05] tracking-[-1px] text-[#111] sm:text-5xl lg:text-4xl"
      >
        {section.heading}
      </h2>

      <!-- Content Blocks -->
      <div class="mt-5 space-y-5">
        {section.contentBlocks.map((item) => (
          <div>
            <h3
              class="text-2xl leading-tight text-black"
            >
              {item.title}
            </h3>

            <p
              class="mt-2 text-[16px] leading-[1.8] text-[#111]"
            >
              {item.description}

              {item.link && (
                <a
                  href={item.link.url}
                  class="ml-1 underline underline-offset-4 transition hover:text-[#0a58ca]"
                >
                  {item.link.label}
                </a>
              )}
            </p>
          </div>
        ))}
      </div>

      <!-- Button -->
      <div class="mt-10">
        <a
          href={section.button.link}
          class="inline-flex min-h-[48px] items-center justify-center rounded-full border-2 border-[#0d5bd7] px-10 text-[18px] font-medium text-[#0d5bd7] transition duration-300 hover:bg-[#0d5bd7] hover:text-white"
        >
          {section.button.label}
        </a>
      </div>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="relative">
      <div class="overflow-hidden rounded-[14px]">
        <img
          src={section.image}
          alt={section.imageAlt}
          width="900"
          height="1100"
          loading="lazy"
          class="h-full max-h-[520px] w-full object-cover transition duration-500 hover:scale-105"
        />
      </div>
    </div>

  </div>
</section>