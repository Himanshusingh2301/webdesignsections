---
// Navbar.astro
import navbarData from '../data/navbar.json';

const { logo, links, cta } = navbarData;
---

<header class="w-full bg-white shadow-sm sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-6 h-[72px] flex items-center justify-between">

    <!-- Logo -->
    <a href={logo.href} class="flex items-center gap-1.5 group">
      <!-- Water Drop SVG Icon -->
      <svg
        class="w-8 h-8 text-sky-500 group-hover:text-sky-600 transition-colors duration-200"
        viewBox="0 0 40 50"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M20 0 C20 0 2 18 2 30 C2 40.5 10.1 48 20 48 C29.9 48 38 40.5 38 30 C38 18 20 0 20 0Z" />
        <!-- Inner highlight -->
        <ellipse cx="14" cy="26" rx="3.5" ry="6" fill="white" opacity="0.3" transform="rotate(-20 14 26)" />
      </svg>
      <span class="text-[1.65rem] font-semibold tracking-tight text-gray-800 group-hover:text-gray-900 transition-colors duration-200">
        {logo.text}
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden md:flex items-center gap-1">
      {links.map((link) => (
        <li class="relative group">
          {link.dropdown ? (
            <>
              <!-- Dropdown Trigger -->
              <button
                class="flex items-center gap-1 px-4 py-2 text-[15px] font-medium text-gray-700 hover:text-gray-900 rounded-md hover:bg-gray-50 transition-all duration-150 cursor-pointer"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {link.label}
                <!-- Chevron Down -->
                <svg
                  class="w-4 h-4 text-gray-500 group-hover:text-gray-700 transition-transform duration-200 group-hover:rotate-180"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown Menu -->
              <div
                class="absolute left-0 top-full mt-1 w-52 bg-white rounded-xl shadow-lg ring-1 ring-gray-100 py-1.5
                       opacity-0 invisible translate-y-1
                       group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                       transition-all duration-200 ease-out"
              >
                {link.dropdown.map((item) => (
                  <a
                    href={item.href}
                    class="block px-4 py-2.5 text-[14px] text-gray-700 hover:text-gray-900 hover:bg-gray-50 transition-colors duration-150"
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </>
          ) : (
            <a
              href={link.href}
              class="block px-4 py-2 text-[15px] font-medium text-gray-700 hover:text-gray-900 rounded-md hover:bg-gray-50 transition-all duration-150"
            >
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <!-- CTA Button -->
    <div class="hidden md:block">
      <a
        href={cta.href}
        class="inline-flex items-center px-5 py-2.5 rounded-full bg-amber-400 hover:bg-amber-500 active:bg-amber-600
               text-white font-semibold text-[15px] tracking-wide
               shadow-sm hover:shadow-md
               transition-all duration-200 ease-out
               focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2"
      >
        {cta.label}
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-md hover:bg-gray-100 transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-gray-700 transition-all duration-300" id="ham-line-1"></span>
      <span class="block w-6 h-0.5 bg-gray-700 transition-all duration-300" id="ham-line-2"></span>
      <span class="block w-6 h-0.5 bg-gray-700 transition-all duration-300" id="ham-line-3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-gray-100 bg-white px-4 pb-4"
  >
    <ul class="flex flex-col mt-2 gap-1">
      {links.map((link) => (
        <li>
          {link.dropdown ? (
            <details class="group/mobile">
              <summary class="flex items-center justify-between px-3 py-2.5 text-[15px] font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 rounded-lg cursor-pointer list-none transition-colors">
                {link.label}
                <svg class="w-4 h-4 text-gray-500 transition-transform group-open/mobile:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="ml-3 mt-1 flex flex-col gap-0.5 border-l-2 border-gray-100 pl-3">
                {link.dropdown.map((item) => (
                  <a href={item.href} class="block py-2 text-[14px] text-gray-600 hover:text-gray-900 transition-colors">
                    {item.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={link.href}
              class="block px-3 py-2.5 text-[15px] font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 rounded-lg transition-colors"
            >
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile CTA -->
    <a
      href={cta.href}
      class="mt-3 flex items-center justify-center w-full px-5 py-3 rounded-full
             bg-amber-400 hover:bg-amber-500 text-white font-semibold text-[15px]
             transition-all duration-200"
    >
      {cta.label}
    </a>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('ham-line-1');
  const line2 = document.getElementById('ham-line-2');
  const line3 = document.getElementById('ham-line-3');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');

    if (isOpen) {
      menu?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      line1!.style.transform = '';
      line2!.style.opacity = '1';
      line3!.style.transform = '';
    } else {
      menu?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      line1!.style.transform = 'translateY(8px) rotate(45deg)';
      line2!.style.opacity = '0';
      line3!.style.transform = 'translateY(-8px) rotate(-45deg)';
    }
  });
</script>